DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never serve dotfiles or dot-directories. The repo root doubles as the
    # document root here, so without this an .env, an .sqlite file or a
    # tool's scratch directory is downloadable verbatim. .well-known stays
    # reachable because Let's Encrypt validation lives there.
    RewriteRule "(^|/)\.(?!well-known)" - [F,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect trailing slash
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send all requests to index.php
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>